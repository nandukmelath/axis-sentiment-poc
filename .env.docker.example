# Deployment config for the single-box Docker install. Copy to .env and fill in.
#
#   cp .env.docker.example .env
#   docker compose up -d --build
#
# This file is the ONLY thing that differs between your laptop and the server.

# ---- required -------------------------------------------------------------
# Postgres password. Any long random string; nothing else needs to know it.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Password gate on the dashboard. LEAVE THIS SET on any public box — without it
# the dashboard, which shows customer complaints and (masked) PII, is open to
# anyone who finds the IP.
AXIS_DASH_PASSWORD=

# At least one LLM key, or every post falls back to lexicon-only scoring with no
# emotion and no routing. Groq's free tier is the easiest start.
GROQ_API_KEY=

# ---- recommended ----------------------------------------------------------
LLM_PROVIDER=groq
LLM_FALLBACKS=cerebras,gemini,openrouter
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

BATCH_SIZE=12
SLEEP_BETWEEN_BATCHES=4.5
PII_MASK=1
CASCADE=1

# ---- optional -------------------------------------------------------------
POSTGRES_USER=axis
POSTGRES_DB=axis
DASHBOARD_PORT=8501

# X / Twitter. The live path is keyless — these only widen coverage.
TWITTER_MODE=auto
# Nitter instances rot constantly. Refresh with:
#   docker compose exec scheduler python -m fetch.twitter_live --probe
TWITTER_NITTER_INSTANCES=nitter.privacyredirect.com,nitter.perennialte.ch

# Engagement refresh cadence: 12 passes x 2h = 24h of coverage per post.
REFRESH_INTERVAL_HOURS=2
REFRESH_MAX_ITERATIONS=12

# Paid sources. All self-skip cleanly when unset.
SCRAPEBADGER_API_KEY=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Set to 1 to enable browser-based stealth sources (trustpilot, mouthshut, gmaps).
# Needs ~1GB extra RAM for Chromium — leave off on a 1GB box.
STEALTH_SOURCES=0
